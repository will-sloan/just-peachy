{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-manifest.v1",
  "title": "Immutable campaign definition",
  "type": "object",
  "required": ["schema_version", "campaign_id", "created_at_utc", "artifact_registry_version", "scenario_schema_version", "benchmark_manifests", "scenario_ids"],
  "properties": {
    "schema_version": {"const": "campaign-manifest.v1"},
    "campaign_id": {"type": "string", "pattern": "^campaign_[a-z0-9][a-z0-9_-]{2,31}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "artifact_registry_version": {"const": "artifact-registry.v1"},
    "scenario_schema_version": {"const": "scenario-definition.v1"},
    "benchmark_manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest_id", "path", "sha256"],
        "properties": {
          "manifest_id": {"type": "string", "pattern": "^manifest_[0-9a-f]{12}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        }
      }
    },
    "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^scenario_[0-9a-f]{12}$"}}
  }
}
