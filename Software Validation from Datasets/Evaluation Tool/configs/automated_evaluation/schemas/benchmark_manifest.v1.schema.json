{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-manifest.v1",
  "title": "Logical row schema for canonical benchmark Parquet",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "manifest_version",
    "benchmark_tier",
    "panel",
    "dataset",
    "recording_id",
    "source_recording_id",
    "utt_id",
    "source_utterance_id",
    "audio_path_project_relative",
    "reference_text",
    "speaker_id",
    "role",
    "augmentation_policy",
    "start_sec",
    "end_sec",
    "duration_sec",
    "word_count",
    "selection_stratum",
    "selection_rank",
    "selection_seed",
    "source_metadata_hash"
  ],
  "properties": {
    "manifest_schema_version": {"const": "benchmark-manifest.v1"},
    "manifest_version": {"const": "benchmark-manifest.v1"},
    "benchmark_tier": {"enum": ["small", "standard", "large"]},
    "panel": {"enum": ["controlled_clean", "native_robustness", "speaker_protocol"]},
    "dataset": {"type": "string", "minLength": 1},
    "recording_id": {"type": "string", "minLength": 1},
    "source_recording_id": {"type": "string", "minLength": 1},
    "utt_id": {"type": "string", "minLength": 1},
    "source_utterance_id": {"type": "string", "minLength": 1},
    "audio_path_project_relative": {"type": "string", "minLength": 1},
    "reference_text": {"type": "string", "minLength": 1},
    "speaker_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["evaluation", "enrollment", "known_probe", "unknown_probe"]},
    "protocol_condition": {"type": ["string", "null"]},
    "augmentation_policy": {"enum": ["allow", "native_only", "review"]},
    "start_sec": {"type": "number", "minimum": 0},
    "end_sec": {"type": "number", "exclusiveMinimum": 0},
    "duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "word_count": {"type": "integer", "minimum": 1},
    "selection_stratum": {"type": "string", "minLength": 1},
    "selection_rank": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "selection_seed": {"const": 3800},
    "source_metadata_hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  },
  "additionalProperties": true
}
