{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-assignment.v1",
  "title": "Deterministic global-scenario worker assignment",
  "type": "object",
  "required": [
    "schema_version",
    "hash_version",
    "hash_algorithm",
    "assignment_id",
    "assignment_sha256",
    "campaign_id",
    "campaign_manifest_sha256",
    "benchmark_manifests",
    "worker_id",
    "expected_git_commit",
    "expected_environment_profile",
    "seed",
    "allow_overlap",
    "selection",
    "scenario_ids",
    "scenarios",
    "identity_catalog",
    "created_at_utc",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "worker-assignment.v1"},
    "hash_version": {"const": "worker-assignment-hash.v1"},
    "hash_algorithm": {"const": "sha256"},
    "assignment_id": {"type": "string", "pattern": "^assignment_[0-9a-f]{12}$"},
    "assignment_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "campaign_id": {"type": "string"},
    "campaign_manifest_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "benchmark_manifests": {"type": "array", "minItems": 1},
    "worker_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$"},
    "expected_git_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "expected_environment_profile": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "allow_overlap": {"type": "boolean"},
    "selection": {"type": "object"},
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^scenario_[0-9a-f]{12}$"}
    },
    "scenarios": {"type": "array", "minItems": 1},
    "identity_catalog": {"type": "object", "required": ["components", "models"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
