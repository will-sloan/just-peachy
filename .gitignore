# Local H2 runtime state contains recoverable audio journals and biometric
# enrollment profiles. Neither belongs in the pre-XVF source freeze.
Software Validation from Datasets/Evaluation Tool/edge_speech_sessions/
Software Validation from Datasets/Evaluation Tool/edge_speech_profiles/

# Generated evaluation evidence can be multi-gigabyte and is reproducible from
# the tracked source, configuration, and small canonical program state.
Software Validation from Datasets/Evaluation Tool/artifacts/
Software Validation from Datasets/Evaluation Tool/benchmarks/full_pipeline/
Software Validation from Datasets/Evaluation Tool/benchmarks/hybrid_speaker_attribution/hybrid_speaker_attribution_product_v2/
Software Validation from Datasets/Evaluation Tool/benchmarks/speaker_enrollment/speaker_enrollment_live_v2/
Software Validation from Datasets/Evaluation Tool/benchmarks/stage11/diarization_product_v2/
Software Validation from Datasets/Evaluation Tool/Software Validation from Datasets/

# Vendor/reference documents and the XVF measurement workbook/ZIP remain local.
# The ZIP contains generated excitation WAVs; later raw captures and RIRs must
# also stay outside Git.
XVF 3800 Testing/Docs/
XVF 3800 Testing/REAL WORLD MEASURMENT/

