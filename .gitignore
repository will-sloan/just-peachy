.DS_Store
RawDatasets/
models/

# Phase-2 generated training-data freezes are local, potentially large, and
# rooted through JP_TRAINING_ROOT. Source, policy, and tests remain tracked.
training/

# Personal documents stay local and outside Git.
Resumes/
~$*.docx

# Local real-model qualification artifacts (recreated by the qualification script)
Software Validation from Datasets/Evaluation Tool/runs/component_qualification/
Software Validation from Datasets/Evaluation Tool/runs/component_readiness_*/
# New evaluator runs are machine-local evidence. Existing historical fixtures
# already tracked by Git remain tracked; the placeholder remains available.
Software Validation from Datasets/Evaluation Tool/runs/*/
!Software Validation from Datasets/Evaluation Tool/runs/.gitkeep
# Prompt-0's small canonical program state is specification, not run output.
!Software Validation from Datasets/Evaluation Tool/runs/full_pipeline_program/
!Software Validation from Datasets/Evaluation Tool/runs/full_pipeline_program/PROGRAM_STATE.json
!Software Validation from Datasets/Evaluation Tool/runs/edge_backend_qualification/
Software Validation from Datasets/Evaluation Tool/runs/edge_backend_qualification/*
