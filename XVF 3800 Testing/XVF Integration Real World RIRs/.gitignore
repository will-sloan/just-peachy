# Source and compact metadata are versioned. Large experimental data stays local.
/*
!/.gitignore
!/*.md
!/*.cmd
!/DATASET_SUMMARY.json
!/RECORDINGS_INDEX.csv
!/planning/
!/measurement_app/
!/tests/
!/tools/
!/simulation/

/measurement_app/assets/
/measurement_app/runtime/
/measurement_app/hardware.lock
/measurement_app/**/*.wav
/measurement_app/**/*.npy
/measurement_app/**/*.log
/measurement_app/**/*.pid

/tools/*
!/tools/prepare_transfer.py
!/tools/diagnostics/

/simulation/*
!/simulation/*.md
!/simulation/config/
!/simulation/scripts/
!/simulation/tests/
!/simulation/rir_library/
!/simulation/reports/
/simulation/rir_library/*
!/simulation/rir_library/v1/
/simulation/rir_library/v1/*
!/simulation/rir_library/v1/*.md
!/simulation/rir_library/v1/*.json
!/simulation/rir_library/v1/*.csv

# S7's accepted source and maintained runner/application code are inputs to PROTO1.
# Execution journals and old frozen experiment trees remain in local storage.
/simulation/reports/*
!/simulation/reports/S7/
/simulation/reports/S7/*
!/simulation/reports/S7/20260917T141700Z/
/simulation/reports/S7/20260917T141700Z/*
!/simulation/reports/S7/20260917T141700Z/runner/
!/simulation/reports/S7/20260917T141700Z/application/
!/simulation/reports/S7/20260917T141700Z/source_epochs/
/simulation/reports/S7/20260917T141700Z/runner/**/*
!/simulation/reports/S7/20260917T141700Z/runner/**/
!/simulation/reports/S7/20260917T141700Z/runner/**/*.py
!/simulation/reports/S7/20260917T141700Z/runner/**/*.md
!/simulation/reports/S7/20260917T141700Z/runner/**/*.diff
!/simulation/reports/S7/20260917T141700Z/runner/**/*.patch
/simulation/reports/S7/20260917T141700Z/application/*
!/simulation/reports/S7/20260917T141700Z/application/prototype_v1/
/simulation/reports/S7/20260917T141700Z/source_epochs/*
!/simulation/reports/S7/20260917T141700Z/source_epochs/gui_startup_v3/

__pycache__/
*.pyc
*.wav
*.npy
*.npz
*.onnx
*.log
*.pid
*.tmp
local_config.json
