/*********************************/
/* AUTOGENERATED. DO NOT MODIFY! */
/* Generated using template {{template_file}} */
/*********************************/

{% for cmd in render_list %}
    {% if   ( ( cmd['name'].startswith('AEC_') or  cmd['name'].startswith('PP_') ) or
            'SUPERHANDSFREE' in cmd['name'] or 'AUDIO_MGR' in cmd['name'] ) and
            ( cmd['default_value'] and cmd['default_value'] != 'NA' ) and
            cmd['type'] != 'CMD_READ_ONLY' %}
        {% set cmd_name = cmd['name'] %}
        {% set cmd_name = cmd_name.replace("BECLEAR_SUPERHANDSFREE_AEC_","").replace("BECLEAR_SUPERHANDSFREE_PP_","") %}
        {% set cmd_name = cmd_name.replace("BECLEAR_SUPERHANDSFREESWB_AEC_","").replace("BECLEAR_SUPERHANDSFREESWB_PP_","") %}
        {% set cmd_name = cmd_name.replace("AEC_RESID_AEC_","").replace("PP_RESID_PP_","") %}
        {% set cmd_name = cmd_name.replace("AUDIO_MGR_RESID_","").replace("AUDIO_MGR_","") %}
.{{cmd_name|lower}} = {{cmd['default_value']}},
    {% endif %}
{% endfor %}
