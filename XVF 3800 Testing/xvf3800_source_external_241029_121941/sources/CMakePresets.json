  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "displayName": "Default Config",
      "description": "Default build",
      "generator": "Unix Makefiles",
      "binaryDir": "$env{rel_path_to_root}./build/default",
      "installDir": "$env{rel_path_to_root}./build/release",
      "cacheVariables": {},
      "vendor": {}
    },
    {
      "name": "_release",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/app_xvf3800",
      "installDir": "${sourceDir}/../",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/xmos_cmake_toolchain/xs3a.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
      }
    },
    {
      "name": "rel_app_xvf3800",
      "displayName": "Release app_xvf3800",
      "description": "xvf3800 device configuration for Linux and Mac host machines",
      "inherits": "_release",
      "condition": {
        "type": "notEquals",
        "lhs": "Windows",
        "rhs": "${hostSystemName}"
      }
    },
    {
      "name": "rel_app_xvf3800_windows",
      "displayName": "Release app_xvf3800 for Windows",
      "description": "xvf3800 device configuration for Windows host machines",
      "inherits": "_release",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "Windows",
        "rhs": "${hostSystemName}"
      }
    },
    {
      "name": "app_xvf3800",
      "displayName": "app_xvf3800",
      "description": "xvf3800 device configuration",
      "binaryDir": "${sourceDir}/build/app_xvf3800",
